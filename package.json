{
  "name": "a-profecia",
  "private": true,
  "version": "1.1.0",
  "type": "module",
  "scripts": {
    "dev": "node node_modules/vite/bin/vite.js --host 0.0.0.0",
    "build": "node node_modules/vite/bin/vite.js build",
    "preview": "node node_modules/vite/bin/vite.js preview --host 0.0.0.0",
    "check": "node scripts/check-syntax.mjs",
    "release:check": "npm run check && npm run stability:check && npm run build",
    "stability:check": "node scripts/stability-audit.mjs"
  },
  "devDependencies": {
    "vite": "7.3.6"
  },
  "dependencies": {
    "@supabase/supabase-js": "2.57.4"
  },
  "engines": {
    "node": ">=20.19.0"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  }
}
